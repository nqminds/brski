{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 13,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default build",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "STRING",
          "value": "Debug"
        },
        "EP_DOWNLOAD_DIR": {
          "type": "PATH",
          "value": "${sourceDir}/build/dl"
        }
      }
    },
    {
      "name": "linux",
      "inherits": "default",
      "displayName": "Linux",
      "description": "Default build for Linux",
      "cacheVariables": {
        "USE_CPPHTTPLIB_LIB": true,
        "BUILD_OPENSSL3_LIB": false,
        "USE_VOUCHER_OPENSSL": true,
        "USE_VOUCHER_WOLFSSL": false,
        "SANITIZE_ADDRESS": false
      }
    },
    {
      "name": "linux-openssl",
      "inherits": "linux",
      "displayName": "Linux with OpenSSL",
      "description": "Build OpenSSL",
      "cacheVariables": {
        "BUILD_OPENSSL3_LIB": true,
        "SANITIZE_ADDRESS": false
      }
    },
    {
      "name": "linux-sanitize",
      "inherits": "linux",
      "displayName": "Linux Sanitize",
      "description": "Use the address sanitizer",
      "cacheVariables": {
        "SANITIZE_ADDRESS": true
      }
    },
    {
      "name": "cheribsd-morello",
      "inherits": "default",
      "displayName": "CHERIBSD Morello",
      "description": "Build for CHERIBSD/Morello",
      "binaryDir": "${sourceDir}/build/cheribsd-morello",
      "cacheVariables": {
        "CMAKE_SYSROOT": "/usr/local/cheri/sdk",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS": "-march=morello -mabi=aapcs",
        "CMAKE_CXX_FLAGS": "-march=morello -mabi=aapcs",
        "CMAKE_EXE_LINKER_FLAGS": "-march=morello -mabi=aapcs",
        "OPENSSL_ROOT_DIR": "/usr/local64/openssl",
        "USE_CPPHTTPLIB_LIB": true,
        "BUILD_OPENSSL3_LIB": false,
        "USE_VOUCHER_OPENSSL": true,
        "USE_VOUCHER_WOLFSSL": false,
        "SANITIZE_ADDRESS": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-openssl",
      "configurePreset": "linux-openssl"
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize"
    },
    {
      "name": "cheribsd-morello",
      "configurePreset": "cheribsd-morello"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-openssl",
      "configurePreset": "linux-openssl"
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize"
    },
    {
      "name": "cheribsd-morello",
      "configurePreset": "cheribsd-morello"
    }
  ]
}